# Compose-level settings for compose.yaml. Copy to .env (gitignored) and fill in.
# The API's own secrets (including its connection string) live in compose.env.

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → install with Docker → the token.
TUNNEL_TOKEN=

# Database to back up: the same Aiven service, split into parts (Aiven console → Overview).
PG_HOST=
PG_PORT=
PG_PASSWORD=
# PG_DATABASE=defaultdb
# PG_USER=avnadmin

# Daily pg_dump to R2. Use its own bucket, and a token scoped to it (Object Read & Write).
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# BACKUP_PASSPHRASE=          # GPG-encrypt the dumps (they contain IP hashes)
# BACKUP_SCHEDULE=@daily
# BACKUP_KEEP_DAYS=30

# Optional
# API_TAG=latest
# API_PORT=8080
