# Secrets for compose.yaml. Copy to compose.env (gitignored) and fill in.
# Names use the standard ASP.NET Core Section__Key form.

# Required. The PostgreSQL database: paste Aiven's Service URI as is
# (postgres://avnadmin:…@….aivencloud.com:12345/defaultdb?sslmode=require),
# or an Npgsql connection string (Host=…;Port=…;Database=…;Username=…;Password=…;SSL Mode=Require).
ConnectionStrings__Guestbook=

# Optional: how often to ping the database so Aiven's free tier doesn't power it off (default 01:00:00, 00:00:00 = off).
# Database__KeepAliveInterval=01:00:00

# Required. Changing it breaks existing likes and pending-entry ownership,
# which are keyed by the salted IP hash.
Api__HashingSalt=

# Optional: GitHub (contribution plot, repo list, post revisions/previews/drafts).
# Fine-grained token, repository access: AlenGeoAlex/alenalex.me only, Contents: read-only.
Github__Token=

# Optional: Discord bot (guestbook moderation, presence, now playing).
# Enable the Server Members and Presence intents on the bot's page in the developer portal.
Discord__BotToken=
Discord__GuildId=
Discord__ChannelId=
Discord__UserId=

# Optional: services to health-check on the status panel (add __1, __2, … for more).
# Homelab__Services__0__Name=nas
# Homelab__Services__0__Url=http://192.168.1.10:5000
