<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AlenAlex.Api</RootNamespace>
    <AssemblyName>alenalex-api</AssemblyName>
    <UserSecretsId>alenalex-api</UserSecretsId>

    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Report trim/AOT warnings on every build, not only on publish. -->
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2057;IL2067;IL2070;IL2072;IL2075;IL2087;IL2091;IL2104;IL3050;IL3051;IL3053</WarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <EventSourceSupport>false</EventSourceSupport>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Development.example.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AlenAlex.Api.Tests" />
    <InternalsVisibleTo Include="AlenAlex.Api.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentMigrator" Version="8.0.1" />
    <PackageReference Include="FluentMigrator.Runner.Postgres" Version="8.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="NetCord" Version="1.0.0-beta.28" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.13" />
  </ItemGroup>

  <!--
    FluentMigrator 8 isn't trim-annotated and warns about assembly scanning, reflection-based
    ADO.NET provider lookup (Assembly.LoadFrom, GAC probing) and DataAnnotations validation.
    None of those paths run: DatabaseMigrator passes an explicit migration list and returns
    NpgsqlFactory.Instance directly. The published binary was checked against a fresh PostgreSQL
    database.

    The suppression is ILC-only, so the Roslyn analyzers still check our own code:
      * FluentMigrator.* assemblies are compiled in single-warn mode, which collapses their
        warnings into one IL2104 / IL3053 each; only those two codes are silenced (nothing else
        is single-warn, TrimmerSingleWarn=false).
      * IL3000 (Assembly.Location) isn't collapsed by single-warn; its only two occurrences are
        FluentMigrator's GAC/AppDomain probing.
  -->
  <Target Name="_FluentMigratorAotWarnings" BeforeTargets="WriteIlcRspFileForCompilation">
    <ItemGroup>
      <ManagedAssemblyToLink Condition="$([System.String]::Copy('%(Filename)').StartsWith('FluentMigrator'))">
        <TrimmerSingleWarn>true</TrimmerSingleWarn>
      </ManagedAssemblyToLink>
      <IlcArg Include="--nowarn:IL2104%3BIL3053%3BIL3000" />
    </ItemGroup>
  </Target>

</Project>
