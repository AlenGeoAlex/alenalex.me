# Paths — relative to repo root
POSTS_DIR=blogs/posts
TEMPLATE_PATH=blogs/post-template.html
BLOGSPEC_OUTPUT=blogs/.blogspec.json
POSTS_OUTPUT_DIR=apps/portfolio-alpine/writing

# ── Cloudflare R2 ───────────────────────────────────────────────
# Account ID: Cloudflare dashboard -> R2 -> Overview (right sidebar)
R2_ACCOUNT_ID=

# API token: R2 -> Manage R2 API Tokens -> Create API Token
# (needs Object Read & Write permission on the bucket below)
R2_ACCESS_KEY=
R2_SECRET_KEY=

# The bucket you're syncing post assets into
R2_BUCKET=alenalex-assets

# Public base URL assets are served from — either R2's public bucket URL
# or a custom domain you've mapped to the bucket (e.g. assets.alenalex.me)
R2_PUBLIC_URL_BASE=https://assets.alenalex.me