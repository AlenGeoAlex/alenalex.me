{
  "navigationFallback": {
    "rewrite": "/index.csr.html",
    "exclude": [
      "/objects/*",
      "/content/*",
      "/*.{css,js,json,xml,webp,png,svg,ico,woff,woff2,webmanifest}"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.csr.html"
    }
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
