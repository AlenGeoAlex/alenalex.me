{
  "name": "site",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:site": "node dist/site/server/server.mjs",
    "content": "node tools/build-content.mjs",
    "prestart": "node tools/build-content.mjs",
    "prebuild": "node tools/build-content.mjs",
    "objects": "node tools/objects/serve.mjs",
    "postbuild": "pagefind --site dist/site/browser --glob \"writing/**/*.html\"",
    "search:dev": "npm run build && pagefind --site dist/site/browser --glob \"writing/**/*.html\" --serve"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.1",
    "@date-fns/tz": "^1.5.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "date-fns": "^4.4.0",
    "express": "^5.1.0",
    "mermaid": "^12.1.0",
    "rxjs": "~7.8.0",
    "three": "^0.186.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "@types/three": "^0.186.0",
    "jsdom": "^30.0.0",
    "marked": "^18.0.14",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1"
  }
}
